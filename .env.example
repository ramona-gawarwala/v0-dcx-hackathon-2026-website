# Copy this file to .env.local and fill in your values. Never commit .env.local.

# AI model access via Vercel AI Gateway (recommended).
# Not needed when deployed on Vercel — auth is automatic there.
AI_GATEWAY_API_KEY=

# Or use a direct provider instead of the gateway (optional).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# App URL (use http://localhost:3000 locally).
NEXT_PUBLIC_APP_URL=http://localhost:3000
